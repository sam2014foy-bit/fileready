<%
  // Shared <head> tags. Pages pass: title (shown before " – Fileready"),
  // fullTitle (replaces the whole title), description, index (true for public pages).
  const site = (typeof siteUrl !== 'undefined' && siteUrl) ? siteUrl.replace(/\/$/, '') : '';
  const pagePath = typeof path !== 'undefined' ? path : '/';
  const pageTitle = locals.fullTitle || ((locals.title ? locals.title + ' – ' : '') + 'Fileready');
  const desc = locals.description || 'Fileready sends mortgage clients a document checklist and a secure upload link, then reminds them about what\'s missing until the file is complete.';
  const image = site + '/static/og-image.png';
%>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= desc %>">
  <meta name="robots" content="<%= locals.index ? 'index, follow' : 'noindex, nofollow' %>">
  <% if (locals.index && site) { %><link rel="canonical" href="<%= site + pagePath %>"><% } %>
  <meta name="theme-color" content="#0F3A44">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Fileready">
  <meta property="og:locale" content="en_IE">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= desc %>">
  <% if (site) { %><meta property="og:url" content="<%= site + pagePath %>">
  <meta property="og:image" content="<%= image %>"><% } %>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Fileready: Stop chasing payslips. A client's mortgage checklist with all 7 documents accepted.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= desc %>">
  <% if (site) { %><meta name="twitter:image" content="<%= image %>"><% } %>
  <meta name="twitter:image:alt" content="Fileready: Stop chasing payslips. A client's mortgage checklist with all 7 documents accepted.">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
