<%- include('partials/head', { title: 'Two-step login' }) %>
<main class="plain-page">
  <span class="wordmark"><%- include('partials/mark') %><span>Fileready</span></span>
  <h1>Enter your code</h1>
  <p>Open your authenticator app and enter the 6-digit code for Fileready. Lost your phone? Enter one of your recovery codes instead.</p>
  <% if (error) { %><p class="notice error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/login/2fa" style="margin-top:24px">
    <label>Code <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="20" required autofocus></label>
    <button class="btn wide">Continue</button>
  </form>
</main>
</body></html>
