<%- include('partials/head', { title: kase.first_name + ' ' + kase.last_name }) %>
<%- include('partials/nav') %>
<%
  const fmt = (d) => new Date(d).toLocaleString('en-IE', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'Europe/Dublin' });
  const required = requests.filter((r) => r.required);
  const done = required.filter((r) => ['accepted', 'waived'].includes(r.status)).length;
  const toReview = requests.filter((r) => r.status === 'received').length;
  const statusChip = { accepted: 'good', waived: 'good', received: 'warn', rejected: 'bad' };
  const statusLabel = { requested: 'Requested', received: 'To review', accepted: 'Accepted', rejected: 'Rejected', waived: 'Not needed' };
  const actionLabel = (a) => a.replace('.', ' ').replace('_', ' ');
%>
<a class="back" href="/">← Cases</a>

<header class="case-head">
  <div>
    <h1><a href="/clients/<%= kase.client_id %>" class="title-link"><%= kase.first_name %> <%= kase.last_name %></a></h1>
    <div class="case-meta">
      <span><%= kase.title %><% if (kase.lender) { %>, <%= kase.lender %><% } %></span>
      <% if (kase.client_email) { %><span><%= kase.client_email %></span><% } %>
      <% if (kase.client_phone) { %><span class="num"><%= kase.client_phone %></span><% } %>
      <% if (kase.adviser_name) { %><span>Adviser: <%= kase.adviser_name %></span><% } %>
    </div>
    <form method="post" action="/cases/<%= kase.id %>/due" class="due-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <% const dueStr = kase.due_date ? dateOnly(kase.due_date) : ''; %>
      <label class="inline small">Documents due <input type="date" name="due_date" value="<%= dueStr %>"></label>
      <button class="link">Save</button>
      <% if (dueStr && dueStr < dateOnly(new Date()) && kase.status === 'open') { %><span class="chip bad">Overdue</span><% } %>
    </form>
  </div>
  <div class="case-state">
    <%- include('partials/ring', { done, total: required.length, size: 116, sub: 'required' }) %>
    <div class="caption">
      <% if (kase.status === 'complete') { %><strong>File complete</strong>Every required document is in.
      <% } else if (toReview) { %><strong><%= toReview %> to review</strong>Your client has uploaded new documents.
      <% } else { %><strong><%= kase.status === 'open' ? 'Collecting' : kase.status[0].toUpperCase() + kase.status.slice(1).replace('_', ' ') %></strong><%= required.length - done %> still to come.<% } %>
    </div>
  </div>
</header>

<% if (typeof flash !== 'undefined' && flash) { %><p class="notice <%= flash.ok ? 'ok' : 'error' %>" role="status"><%= flash.text %></p><% } %>

<section class="surface">
  <div class="chase">
    <div>
      <h2>Chasing</h2>
      <% if (!kase.chasing_started_at) { %>
        <p class="status-line muted">Not started. Fileready will email <%= kase.first_name %> the list and a secure upload link, then remind them every <%= firm.reminder_every_days %> days, Monday to Saturday between 9am and 7pm, until everything is in.</p>
      <% } else if (kase.status !== 'open') { %>
        <p class="status-line"><strong>Finished.</strong> <span class="muted">No more reminders: the case is <%= kase.status === 'complete' ? 'complete' : kase.status.replace('_', ' ') %>.</span></p>
      <% } else if (kase.chasing_stopped === 'limit_reached') { %>
        <p class="status-line"><strong class="bad-text">No response after <%= kase.reminders_sent %> emails.</strong> <span class="muted">Reminders have stopped. Time for a phone call, or resume to send more.</span></p>
      <% } else if (kase.chasing_stopped === 'no_email') { %>
        <p class="status-line"><strong class="bad-text">Stopped: no email address for this client.</strong></p>
      <% } else if (kase.reminders_paused) { %>
        <p class="status-line"><strong>Paused.</strong> <span class="muted"><%= kase.reminders_sent %> email<%= kase.reminders_sent === 1 ? '' : 's' %> sent so far.</span></p>
      <% } else { %>
        <p class="status-line"><strong>On.</strong> <%= kase.reminders_sent %> email<%= kase.reminders_sent === 1 ? '' : 's' %> sent.
          <% if (kase.next_reminder_at) { %>Next reminder <span class="when"><%= fmt(kase.next_reminder_at) %></span><span class="muted">, or the next weekday morning.</span><% } %></p>
      <% } %>
      <% const canText = firm.sms_enabled && kase.client_phone; %>
      <% if (!kase.client_email && !canText) { %><p class="status-line small bad-text">This client has no email address<%= firm.sms_enabled ? ' or mobile number' : '' %>, so Fileready can't chase them.</p>
      <% } else if (canText) { %><p class="status-line small muted">Reminders go by <%= kase.client_email ? 'email and text' : 'text' %>.</p><% } %>
    </div>
    <div class="chase-actions">
      <% const btn = (path, label, cls) => { %>
        <form method="post" action="/cases/<%= kase.id %>/chase/<%= path %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="<%= cls %>"><%= label %></button></form>
      <% } %>
      <% if (kase.status === 'open' && (kase.client_email || canText)) { %>
        <% if (!kase.chasing_started_at) { btn('start', 'Email client & start chasing', 'btn'); } else { %>
          <% btn('now', 'Send reminder now', 'btn quiet small'); %>
          <% if (kase.reminders_paused || kase.chasing_stopped) { btn('resume', 'Resume reminders', 'link'); } else { btn('pause', 'Pause reminders', 'link'); } %>
        <% } %>
      <% } %>
    </div>
  </div>
  <% if (reminders.length) { %>
  <ul class="sent-list">
    <% for (const r of reminders) { %>
      <li><span class="t"><%= fmt(r.sent_at || r.created_at) %></span>
        <span><%= { first: 'First request', reminder: 'Reminder', manual: 'Reminder (sent by you)' }[r.kind] %> by <%= r.channel === 'sms' ? 'text' : 'email' %> to <%= r.recipient %>, <%= r.outstanding %> outstanding
        <% if (r.status === 'failed') { %><span class="bad-text">– failed, will retry</span><% } else if (r.status === 'scheduled') { %><span class="muted">– sending</span><% } %></span></li>
    <% } %>
  </ul>
  <% } %>
</section>

<% if (newLink) { %>
<section class="surface highlight">
  <div class="surface-body">
    <h2>Upload link for <%= kase.first_name %></h2>
    <p>Copy this now and send it yourself. For security it won't be shown again. It works for 14 days, or until Fileready emails a newer link.</p>
    <input class="copy" readonly value="<%= newLink %>" aria-label="Upload link">
  </div>
</section>
<% } %>

<section class="surface">
  <div class="surface-head">
    <h2>Documents</h2>
    <div class="row-actions" style="align-items:center;gap:20px">
      <% if (requests.some((r) => r.documents.length && ['accepted', 'received'].includes(r.status))) { %><a class="link-plain" href="/cases/<%= kase.id %>/export">Download all (zip)</a><% } %>
      <form method="post" action="/cases/<%= kase.id %>/links"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="link" title="Make a link to send yourself, for example by WhatsApp">Copy a link instead</button></form>
    </div>
  </div>
  <% if (!requests.length) { %><p class="surface-body muted">No documents on the checklist yet. Add one below.</p><% } %>
  <ul class="checklist" style="margin-top:8px">
  <% for (const r of requests) { %>
    <li class="item status-<%= r.status %>">
      <div class="item-main">
        <strong><%= r.label %></strong><% if (!r.required) { %> <span class="opt">optional</span><% } %>
        <% if (r.help_text) { %><div class="help"><%= r.help_text %></div><% } %>
        <% if (r.status === 'rejected') { %><div class="note bad-text">Rejected: <%= r.rejected_reason %></div><% } %>
        <% for (const d of r.documents) { %>
          <div class="file"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5h5l3 3v8H3z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
            <a href="/documents/<%= d.id %>"><%= d.original_filename %></a>
            <span class="muted num"><%= d.size_bytes < 1048576 ? Math.max(1, Math.round(d.size_bytes / 1024)) + ' KB' : (d.size_bytes / 1048576).toFixed(1) + ' MB' %>, <%= new Date(d.uploaded_at).toLocaleString('en-IE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Dublin' }) %></span>
            <form method="post" action="/documents/<%= d.id %>/remove" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger" title="Delete this file, e.g. if the client uploaded the wrong one">Remove</button></form></div>
        <% } %>
      </div>
      <div class="item-side">
        <span class="chip <%= statusChip[r.status] || '' %>"><%= statusLabel[r.status] %></span>
        <div class="actions">
          <% const act = (a, label, cls) => { %>
            <form method="post" action="/cases/<%= kase.id %>/requests/<%= r.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= a %>"><button class="link <%= cls || '' %>"><%= label %></button></form>
          <% } %>
          <% if (r.status === 'received') { act('accept', 'Accept'); } %>
          <% if (['requested','received','rejected'].includes(r.status)) { act('waive', 'Not needed'); } %>
          <% if (['accepted','waived'].includes(r.status)) { act('reopen', 'Reopen'); } %>
          <% if (!r.documents.length) { %><form method="post" action="/cases/<%= kase.id %>/requests/<%= r.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link quiet" title="Take this item off the checklist">Remove</button></form><% } %>
        </div>
        <% if (['received','accepted'].includes(r.status)) { %>
          <form method="post" action="/cases/<%= kase.id %>/requests/<%= r.id %>" class="reject">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="reject">
            <input name="reason" placeholder="Reason, e.g. blurry" required maxlength="300" aria-label="Reason for rejecting"><button class="link danger">Reject</button>
          </form>
        <% } %>
      </div>
    </li>
  <% } %>
  </ul>
  <form method="post" action="/cases/<%= kase.id %>/requests" class="add">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="label" placeholder="Add a document, e.g. P60 for 2025" required maxlength="150" aria-label="Document to add">
    <label class="inline"><input type="checkbox" name="required" checked> Required</label>
    <button class="btn quiet small">Add</button>
  </form>
</section>

<section class="surface" id="notes" style="margin-top:20px">
  <div class="surface-head"><h2>Notes</h2><span class="muted small">Only your team sees these</span></div>
  <div class="surface-body">
    <form method="post" action="/cases/<%= kase.id %>/notes" class="note-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <textarea name="body" rows="2" maxlength="2000" placeholder="e.g. Rang Niamh, payslips coming Monday" aria-label="New note" required></textarea>
      <button class="btn quiet small">Add note</button>
    </form>
    <% if (notes.length) { %><ul class="plain notes">
      <% for (const n of notes) { %><li><p><%= n.body %></p><span class="small muted"><%= n.full_name || 'Former colleague' %>, <%= fmt(n.created_at) %></span></li><% } %>
    </ul><% } %>
  </div>
</section>

<div class="two-col">
  <section class="surface">
    <div class="surface-head"><h2>Upload links</h2></div>
    <div class="surface-body">
      <% if (!links.length) { %><p class="muted small" style="margin:0">No active links. Starting chasing creates one automatically.</p><% } %>
      <ul class="plain links">
      <% for (const l of links) { %>
        <li><span>Created <span class="num"><%= new Date(l.created_at).toLocaleDateString('en-IE') %></span>, expires <span class="num"><%= new Date(l.expires_at).toLocaleDateString('en-IE') %></span><br>
          <span class="muted"><%= l.last_used_at ? 'Last opened ' + new Date(l.last_used_at).toLocaleString('en-IE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Dublin' }) : 'Not opened yet' %></span></span>
          <form method="post" action="/cases/<%= kase.id %>/links/<%= l.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link danger">Turn off</button></form>
        </li>
      <% } %>
      </ul>
    </div>
  </section>
  <section class="surface">
    <div class="surface-head"><h2>History</h2></div>
    <div class="surface-body">
      <ul class="plain history">
      <% for (const h of history) { %>
        <li><span class="t"><%= fmt(h.created_at) %></span>
          <span><%= h.actor_type === 'client' ? 'Client' : (h.full_name || 'Fileready') %>: <%= actionLabel(h.action) %><% if (h.details && h.details.reason) { %>, <%= h.details.reason %><% } %></span></li>
      <% } %>
      </ul>
    </div>
  </section>
</div>
<section class="surface" style="margin-top:20px">
  <div class="surface-head"><h2>Case</h2></div>
  <div class="surface-body case-actions">
    <p class="muted small" style="margin:0 0 14px">
      <% if (kase.status === 'closed') { %>Closed <%= kase.closed_at ? new Date(kase.closed_at).toLocaleDateString('en-IE') : '' %>. Reopen it to collect more documents.
      <% } else if (kase.status === 'on_hold') { %>On hold. No reminders go out until you reopen it.
      <% } else { %>Close the case once the mortgage is drawn down, or put it on hold to pause everything.<% } %>
    </p>
    <div class="row-actions">
      <% const st = (a, label, cls) => { %><form method="post" action="/cases/<%= kase.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= a %>"><button class="<%= cls %>"><%= label %></button></form><% } %>
      <% if (['open', 'complete'].includes(kase.status)) { st('close', 'Close case', 'btn quiet small'); st('hold', 'Put on hold', 'btn quiet small'); } else { st('reopen', 'Reopen case', 'btn quiet small'); } %>
    </div>
    <% if (user.role === 'owner') { %>
    <form method="post" action="/cases/<%= kase.id %>/delete" class="danger-zone">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="inline small"><input type="checkbox" name="confirm" value="yes" required> Delete this case and all its files for good</label>
      <button class="btn danger small">Delete case</button>
    </form>
    <% } %>
  </div>
</section>
<%- include('partials/foot', { motion: true }) %>
