<%- include('partials/head', { title: kase.first_name + ' ' + kase.last_name }) %>
<%- include('partials/nav') %>
<p class="muted small"><a href="/">← Cases</a></p>
<div class="row between">
  <div>
    <h1><%= kase.first_name %> <%= kase.last_name %></h1>
    <p class="muted"><%= kase.title %><% if (kase.lender) { %> · <%= kase.lender %><% } %>
      <% if (kase.client_email) { %> · <%= kase.client_email %><% } %><% if (kase.client_phone) { %> · <%= kase.client_phone %><% } %></p>
  </div>
  <span class="pill big <%= kase.status === 'complete' ? 'good' : '' %>"><%= kase.status === 'complete' ? 'File complete' : kase.status[0].toUpperCase() + kase.status.slice(1) %></span>
</div>


<% if (typeof flash !== 'undefined' && flash) { %><p class="<%= flash.ok ? 'ok' : 'error' %>" role="status"><%= flash.text %></p><% } %>

<section class="card chasing">
  <% const fmt = (d) => new Date(d).toLocaleString('en-IE', { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZone: 'Europe/Dublin' }); %>
  <div class="row between">
    <div>
      <h2>Chasing</h2>
      <% if (!kase.chasing_started_at) { %>
        <p class="muted">Not started. Fileready will email <%= kase.first_name %> the list and a secure upload link, then send a reminder every <%= firm.reminder_every_days %> days (Mon–Sat, 9am–7pm) until everything is in.</p>
      <% } else if (kase.status !== 'open') { %>
        <p><strong>Finished.</strong> <span class="muted">No more reminders: the case is <%= kase.status === 'complete' ? 'complete' : kase.status %>.</span></p>
      <% } else if (kase.chasing_stopped === 'limit_reached') { %>
        <p><strong class="bad-text">No response after <%= kase.reminders_sent %> emails.</strong> <span class="muted">Reminders have stopped. Time for a phone call, or resume to send more.</span></p>
      <% } else if (kase.chasing_stopped === 'no_email') { %>
        <p><strong class="bad-text">Stopped: no email address for this client.</strong></p>
      <% } else if (kase.reminders_paused) { %>
        <p><strong>Paused.</strong> <span class="muted"><%= kase.reminders_sent %> email<%= kase.reminders_sent === 1 ? '' : 's' %> sent so far.</span></p>
      <% } else { %>
        <p><strong>On.</strong> <%= kase.reminders_sent %> email<%= kase.reminders_sent === 1 ? '' : 's' %> sent.
          <% if (kase.next_reminder_at) { %>Next reminder: <strong><%= fmt(kase.next_reminder_at) %></strong> <span class="muted">(or the next weekday morning)</span><% } %></p>
      <% } %>
      <% if (!kase.client_email) { %><p class="small bad-text">This client has no email address, so Fileready can't chase them by email.</p><% } %>
    </div>
    <div class="chase-actions">
      <% const btn = (path, label, cls) => { %>
        <form method="post" action="/cases/<%= kase.id %>/chase/<%= path %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="<%= cls %>"><%= label %></button></form>
      <% } %>
      <% if (kase.status === 'open' && kase.client_email) { %>
        <% if (!kase.chasing_started_at) { btn('start', 'Email client & start chasing', 'btn'); } else { %>
          <% btn('now', 'Send reminder now', 'btn small'); %>
          <% if (kase.reminders_paused || kase.chasing_stopped) { btn('resume', 'Resume reminders', 'link'); } else { btn('pause', 'Pause reminders', 'link'); } %>
        <% } %>
      <% } %>
    </div>
  </div>
  <% if (reminders.length) { %>
  <ul class="plain small sent-list">
    <% for (const r of reminders) { %>
      <li><span class="muted"><%= fmt(r.sent_at || r.created_at) %></span>
        <%= { first: 'First request', reminder: 'Reminder', manual: 'Reminder (sent by you)' }[r.kind] %> to <%= r.recipient %>
        · <%= r.outstanding %> item<%= r.outstanding === 1 ? '' : 's' %> outstanding
        <% if (r.status === 'failed') { %><span class="bad-text">· failed, will retry</span><% } else if (r.status === 'scheduled') { %><span class="muted">· sending…</span><% } %></li>
    <% } %>
  </ul>
  <% } %>
</section>

<% if (newLink) { %>
<div class="card highlight">
  <h3>Upload link for <%= kase.first_name %></h3>
  <p>Copy this now and send it to your client yourself. For security it won't be shown again. It works for 14 days, or until Fileready emails them a newer link.</p>
  <input class="copy" readonly value="<%= newLink %>">
</div>
<% } %>

<section class="card">
  <div class="row between">
    <h2>Documents</h2>
    <form method="post" action="/cases/<%= kase.id %>/links"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="link small" title="Make a link to send yourself, e.g. by WhatsApp">Copy a link instead</button></form>
  </div>
  <% if (!requests.length) { %><p class="muted">No documents on the checklist yet. Add one below.</p><% } %>
  <ul class="checklist">
  <% for (const r of requests) { %>
    <li class="item status-<%= r.status %>">
      <div class="item-main">
        <strong><%= r.label %></strong><% if (!r.required) { %> <span class="muted small">(optional)</span><% } %>
        <% if (r.help_text) { %><div class="muted small"><%= r.help_text %></div><% } %>
        <% if (r.status === 'rejected') { %><div class="small bad-text">Rejected: <%= r.rejected_reason %></div><% } %>
        <% for (const d of r.documents) { %>
          <div class="small file"><a href="/documents/<%= d.id %>"><%= d.original_filename %></a>
            <span class="muted"><%= d.size_bytes < 1048576 ? Math.max(1, Math.round(d.size_bytes / 1024)) + ' KB' : (d.size_bytes / 1048576).toFixed(1) + ' MB' %> · <%= new Date(d.uploaded_at).toLocaleString('en-IE', { dateStyle: 'medium', timeStyle: 'short' }) %></span></div>
        <% } %>
      </div>
      <div class="item-side">
        <span class="pill <%= { accepted: 'good', waived: 'good', received: 'warn', rejected: 'bad' }[r.status] || '' %>"><%= r.status[0].toUpperCase() + r.status.slice(1) %></span>
        <div class="actions">
          <% const act = (a, label, cls) => { %>
            <form method="post" action="/cases/<%= kase.id %>/requests/<%= r.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="<%= a %>"><button class="link <%= cls || '' %>"><%= label %></button></form>
          <% } %>
          <% if (r.status === 'received') { act('accept', 'Accept'); } %>
          <% if (['requested','received','rejected'].includes(r.status)) { act('waive', 'Not needed'); } %>
          <% if (['accepted','waived'].includes(r.status)) { act('reopen', 'Reopen'); } %>
        </div>
        <% if (['received','accepted'].includes(r.status)) { %>
          <form method="post" action="/cases/<%= kase.id %>/requests/<%= r.id %>" class="reject">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="reject">
            <input name="reason" placeholder="Reason, e.g. blurry" required maxlength="300"><button class="link bad-text">Reject</button>
          </form>
        <% } %>
      </div>
    </li>
  <% } %>
  </ul>
  <form method="post" action="/cases/<%= kase.id %>/requests" class="row add">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="label" placeholder="Add a document, e.g. P60 for 2025" required maxlength="150">
    <label class="inline"><input type="checkbox" name="required" checked> Required</label>
    <button class="btn small">Add</button>
  </form>
</section>

<% if (links.length) { %>
<section class="card">
  <h2>Active upload links</h2>
  <ul class="plain">
  <% for (const l of links) { %>
    <li class="row between">
      <span class="small">Created <%= new Date(l.created_at).toLocaleDateString('en-IE') %> · expires <%= new Date(l.expires_at).toLocaleDateString('en-IE') %>
        · <%= l.last_used_at ? 'last opened ' + new Date(l.last_used_at).toLocaleString('en-IE', { dateStyle: 'medium', timeStyle: 'short' }) : 'not opened yet' %></span>
      <form method="post" action="/cases/<%= kase.id %>/links/<%= l.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link bad-text">Turn off</button></form>
    </li>
  <% } %>
  </ul>
</section>
<% } %>

<section class="card">
  <h2>History</h2>
  <ul class="plain history small">
  <% for (const h of history) { %>
    <li><span class="muted"><%= new Date(h.created_at).toLocaleString('en-IE', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
      <%= h.actor_type === 'client' ? 'Client' : (h.full_name || 'System') %> · <%= h.action.replace('.', ' ').replace('_', ' ') %>
      <% if (h.details && h.details.reason) { %>: <%= h.details.reason %><% } %></li>
  <% } %>
  </ul>
</section>
<%- include('partials/foot') %>
