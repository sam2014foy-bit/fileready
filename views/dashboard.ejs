<%- include('partials/head', { title: 'Cases' }) %>
<%- include('partials/nav') %>
<div class="page-head">
  <div>
    <h1>Cases</h1>
    <p><% if (counts.review) { %><%= counts.review %> <%= counts.review === 1 ? 'file has' : 'files have' %> documents waiting for your review.<% } else { %>Nothing is waiting for your review.<% } %></p>
  </div>
  <nav class="segments" aria-label="Filter cases">
    <% for (const [k, label] of [['open', 'Open'], ['complete', 'Complete'], ['all', 'All']]) { %>
      <a href="/?show=<%= k %>" <%- filter === k ? 'aria-current="page"' : '' %>><%= label %> <span class="count"><%= counts[k] %></span></a>
    <% } %>
  </nav>
</div>
<div class="today" aria-label="Today">
  <a href="/?show=review" class="today-item <%= filter === 'review' ? 'on' : '' %>"><b class="num"><%= counts.docs_to_review %></b><span>document<%= counts.docs_to_review === 1 ? '' : 's' %> to review</span></a>
  <a href="/?show=stuck" class="today-item <%= filter === 'stuck' ? 'on' : '' %>"><b class="num"><%= counts.stuck %></b><span>client<%= counts.stuck === 1 ? '' : 's' %> not responding</span></a>
  <a href="/?show=due" class="today-item <%= filter === 'due' ? 'on' : '' %>"><b class="num"><%= counts.due %></b><span>due within a week<% if (counts.overdue) { %>, <strong class="bad-text"><%= counts.overdue %> overdue</strong><% } %></span></a>
</div>
<% if (['review', 'stuck', 'due'].includes(filter)) { %><p class="small muted" style="margin:-8px 0 16px">Showing <%= { review: 'cases with documents to review', stuck: 'cases where chasing has stopped', due: 'cases due within a week' }[filter] %>. <a href="/">Show all open cases</a></p><% } %>
<% if (!cases.length) { %>
  <div class="surface empty">
    <h2><%= filter === 'complete' ? 'No complete files yet' : filter === 'open' ? 'No open cases' : 'No cases yet' %></h2>
    <p><%= filter === 'complete' ? 'Files land here once every required document is accepted.' : 'Add a client and Fileready will start collecting their documents.' %></p>
    <% if (filter !== 'complete') { %><a class="btn" href="/clients/new">Add a client</a><% } %>
  </div>
<% } else { %>
<div class="surface">
<table class="ledger">
  <thead><tr><th>Client</th><th>Documents</th><th>Needs you</th><th>Chasing</th><th>Status</th></tr></thead>
  <tbody>
  <% for (const c of cases) { const pct = c.required_total ? Math.round(100 * c.required_done / c.required_total) : 0; %>
    <tr>
      <td class="client-cell"><a href="/cases/<%= c.id %>"><%= c.first_name %> <%= c.last_name %></a>
        <span class="sub"><%= c.title %><% if (c.lender) { %>, <%= c.lender %><% } %></span>
        <% if (c.due_date && c.status === 'open') { const d = dateOnly(c.due_date); %><span class="chip <%= d < today ? 'bad' : 'plain' %>" style="margin-top:6px"><%= d < today ? 'Overdue' : 'Due' %> <%= formatDue(d).replace(/^\w+ /, '') %></span><% } %></td>
      <td><div class="meter" title="<%= c.required_done %> of <%= c.required_total %> required documents done"><span class="track"><span class="fill" style="width:<%= pct %>%"></span></span><span class="frac"><%= c.required_done %>/<%= c.required_total %></span></div></td>
      <td><% if (c.awaiting_review) { %><span class="chip info"><%= c.awaiting_review %> to review</span><% } %>
          <% if (c.rejected) { %><span class="chip returned"><%= c.rejected %> sent back</span><% } %></td>
      <td class="chasing-cell"><% if (c.status !== 'open') { %>–
          <% } else if (!c.chasing_started_at) { %>Not started
          <% } else if (c.chasing_stopped === 'limit_reached') { %><span class="chip bad">No reply after <%= c.reminders_sent %></span>
          <% } else if (c.chasing_stopped) { %><span class="chip bad">Stopped</span>
          <% } else if (c.reminders_paused) { %>Paused
          <% } else if (c.next_reminder_at) { %>Next <strong><%= new Date(c.next_reminder_at).toLocaleDateString('en-IE', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/Dublin' }) %></strong>
          <% } else { %>Waiting<% } %></td>
      <td><% if (c.status === 'complete') { %><span class="chip brass">File complete</span><% } else { %><span class="chip"><%= c.status[0].toUpperCase() + c.status.slice(1).replace('_', ' ') %></span><% } %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
<% } %>
<%- include('partials/foot') %>
