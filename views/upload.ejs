<%- include('partials/head', { title: 'Upload documents' }) %>
<%
  const required = requests.filter((r) => r.required);
  const done = required.filter((r) => ['accepted', 'waived', 'received'].includes(r.status)).length;
  const lock = '<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="2.5" y="6" width="9" height="6.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4.5 6V4.5a2.5 2.5 0 015 0V6" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>';
%>
<main class="client-page client">
  <div class="client-top">
    <span class="firm"><%= info.firm_name %></span>
    <span class="secure"><%- lock %> Secure upload</span>
  </div>
  <div class="client-hero">
    <div>
      <h1>Hi <%= info.first_name %>, here's what we need</h1>
      <p>Upload each document below. PDFs and phone photos are fine, up to 25 MB each. You can come back to this page any time while the link is active.</p>
    </div>
    <%- include('partials/ring', { done, total: required.length, size: 104, sub: 'sent' }) %>
  </div>
  <% if (message) { %><p class="notice ok" role="status"><%= message %></p><% } %>
  <% if (error) { %><p class="notice error" role="alert"><%= error %></p><% } %>
  <section class="surface">
  <ul class="checklist">
  <% for (const r of requests) { const finished = ['accepted','waived'].includes(r.status); %>
    <li class="item status-<%= r.status %>" data-rid="<%= r.id %>">
      <div class="item-main">
        <strong><%= r.label %></strong><% if (!r.required) { %> <span class="opt">if it applies</span><% } %>
        <% if (r.help_text) { %><div class="help"><%= r.help_text %></div><% } %>
        <% if (r.status === 'rejected') { %><div class="note bad-text">Please upload again: <%= r.rejected_reason %></div><% } %>
        <% if (r.status === 'received') { %><div class="done-mark">Received, thanks. Your broker will check it.</div><% } %>
        <% if (finished) { %><div class="done-mark"><%= r.status === 'accepted' ? 'All done ✓' : 'Not needed' %></div><% } %>
      </div>
      <% if (!finished) { %>
      <form method="post" action="/u/<%= token %>/<%= r.id %>" enctype="multipart/form-data" class="item-side">
        <input type="file" name="file" accept="application/pdf,image/jpeg,image/png,image/heic" required aria-label="Choose a file for <%= r.label %>">
        <button class="btn small quiet"><%= r.file_count ? 'Upload another' : 'Upload' %></button>
        <span class="uploading" role="status"></span>
      </form>
      <% } %>
    </li>
  <% } %>
  </ul>
  </section>
  <p class="client-foot"><%- lock %><span>Your files go straight to <%= info.firm_name %> over an encrypted connection and are stored in Ireland. Only your broker's team can open them.</span></p>
</main>
<script src="/static/vendor/gsap/gsap.min.js" defer></script>
<script src="/static/upload.js" defer></script>
<script src="/static/motion.js" defer></script>
</body></html>
