<%- include('partials/head', { title: 'Set your password' }) %>
<main class="plain-page">
  <a class="wordmark" href="/login"><%- include('partials/mark') %><span>Fileready</span></a>
  <% if (!valid) { %>
    <h1>This link isn't active</h1>
    <p>It may have expired or already been used. You can ask for a new one.</p>
    <p><a class="btn quiet small" href="/forgot">Send a new link</a></p>
  <% } else { %>
    <h1><%= who.purpose === 'invite' ? 'Set up your login' : 'Set a new password' %></h1>
    <p><%= who.full_name %>, <%= who.email %></p>
    <% if (error) { %><p class="notice error" role="alert"><%= error %></p><% } %>
    <form method="post" action="/reset/<%= token %>" style="margin-top:24px">
      <label>New password <input type="password" name="new_password" autocomplete="new-password" minlength="12" required autofocus></label>
      <label>New password again <input type="password" name="confirm" autocomplete="new-password" minlength="12" required></label>
      <p class="hint">At least 12 characters. Four or five unrelated words are easy to remember and hard to guess.</p>
      <button class="btn wide"><%= who.purpose === 'invite' ? 'Set password and continue' : 'Set new password' %></button>
    </form>
  <% } %>
</main>
</body></html>
