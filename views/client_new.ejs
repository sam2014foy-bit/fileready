<%- include('partials/head', { title: 'New client' }) %>
<%- include('partials/nav') %>
<a class="back" href="/clients">← Clients</a>
<form method="post" action="/clients" class="surface form-surface">
  <h1>New client</h1>
  <% if (error) { %><p class="notice error" role="alert"><%= error %></p><% } %>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="two">
    <label>First name <input name="first_name" value="<%= values.first_name || '' %>" autocomplete="off" required maxlength="80"></label>
    <label>Last name <input name="last_name" value="<%= values.last_name || '' %>" autocomplete="off" required maxlength="80"></label>
  </div>
  <label>Email <input type="email" name="email" value="<%= values.email || '' %>" autocomplete="off" maxlength="200"></label>
  <label>Mobile <input type="tel" name="phone" value="<%= values.phone || '' %>" placeholder="+353 87 …" autocomplete="off" maxlength="40" pattern="[0-9+\(\)\s.\-]{7,40}" title="Digits, spaces and + only, for example 087 123 4567"></label>
  <p class="hint">Fileready chases by email, so add an email address if you have one.</p>
  <button class="btn">Save and start a case</button>
</form>
<%- include('partials/foot') %>
