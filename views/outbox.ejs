<%- include('partials/head', { title: 'Outbox' }) %>
<main class="outbox">
  <h1>Emails sent</h1>
  <p class="muted">Only on your computer. Emails aren't really sent here, so you can see exactly what clients would get.</p>
  <% if (!emails.length) { %><p>No emails yet.</p><% } %>
  <% for (const e of emails) { %>
    <section class="surface" style="margin-top:20px"><div class="surface-body">
      <p class="small muted" style="margin:0 0 6px"><%= new Date(e.sentAt).toLocaleString('en-IE') %>. To <%= e.toName %> &lt;<%= e.to %>&gt;, from <%= e.fromName %><% if (e.replyTo) { %>, replies to <%= e.replyTo %><% } %></p>
      <h2><%= e.subject %></h2>
      <pre><%= e.text %></pre>
    </div></section>
  <% } %>
</main>
</body></html>
