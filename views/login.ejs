<%- include('partials/head', { title: 'Log in', index: true, description: 'Log in to Fileready, the document chasing app for Irish mortgage brokers.' }) %>
<div class="auth">
  <section class="auth-art">
    <a class="wordmark" href="/login"><%- include('partials/mark') %><span>Fileready</span></a>
    <svg class="motif" viewBox="0 0 520 520" aria-hidden="true">
      <path d="M72 40H352L432 120V468Q432 492 408 492H72Q48 492 48 468V64Q48 40 72 40Z" fill="#15392F"/>
      <path d="M352 40V104Q352 120 368 120H432Z" fill="#6FDDB2"/>
      <rect x="96" y="168" width="240" height="14" rx="7" fill="#6FDDB2" opacity=".55"/>
      <rect x="96" y="212" width="190" height="14" rx="7" fill="#6FDDB2" opacity=".55"/>
      <rect x="96" y="256" width="270" height="14" rx="7" fill="#6FDDB2" opacity=".55"/>
      <rect x="96" y="300" width="150" height="14" rx="7" fill="#6FDDB2" opacity=".55"/>
      <rect x="96" y="344" width="220" height="14" rx="7" fill="#6FDDB2" opacity=".55"/>
    </svg>
    <blockquote>
      <p>Every document in. Without the chasing.</p>
      <span>Your clients get a checklist and a secure link. Fileready reminds them until the file is complete.</span>
    </blockquote>
  </section>
  <main class="auth-form">
    <form method="post" action="/login">
      <h1>Log in</h1>
      <p class="lede">Welcome back. Pick up where your files left off.</p>
      <% if (typeof notice !== 'undefined' && notice) { %><p class="notice ok" role="status"><%= notice %></p><% } %>
      <% if (error) { %><p class="notice error" role="alert"><%= error %></p><% } %>
      <label>Email <input type="email" name="email" value="<%= email %>" autocomplete="username" required autofocus></label>
      <label>Password <input type="password" name="password" autocomplete="current-password" required maxlength="200"></label>
      <button class="btn wide">Log in</button>
      <p class="small" style="margin-top:20px;text-align:center"><a href="/forgot">Forgot your password?</a></p>
      <% if (typeof allowSignup !== 'undefined' && allowSignup) { %><p class="small muted" style="text-align:center">New to Fileready? <a href="/signup">Start a free trial</a></p><% } %>
      <p class="small muted" style="text-align:center"><a href="/security">Security</a> &nbsp; <a href="/privacy">Privacy</a> &nbsp; <a href="/terms">Terms</a></p>
    </form>
  </main>
</div>
</body></html>
