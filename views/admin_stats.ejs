<%- include('partials/head', { title: 'Website stats' }) %>
<%- include('partials/nav') %>
<%
  const t = r.totals || { views: 0, visitors: 0 };
  const ev = r.events || {};
  const leads = (ev.demo_requested || 0) + (ev.signup_completed || 0);
  const rate = t.visitors ? (leads / t.visitors * 100) : 0;
  const max = Math.max(1, ...series.map((d) => d.visitors));
  const nice = (n) => Number(n).toLocaleString('en-IE');
  const label = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-IE', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  const ctaNames = { hero: 'Top of page', header: 'Header button', story: 'After "how it works"', footer: 'Bottom of page' };
  const pageNames = { '/': 'Home', '/security': 'Security', '/privacy': 'Privacy policy', '/terms': 'Terms', '/dpa': 'Data processing agreement', '/demo': 'Demo form', '/signup': 'Sign-up form' };
%>
<div class="page-head">
  <div><h1>Website stats</h1><p>Visits to your public pages since <%= label(String(r.since)) %>. No cookies, no personal data.</p></div>
  <nav class="segments" aria-label="Period">
    <% for (const d of [7, 30, 90]) { %><a href="/admin/stats?days=<%= d %>" <%- d === days ? 'aria-current="page"' : '' %>><%= d %> days</a><% } %>
  </nav>
</div>

<div class="stat-tiles">
  <div class="stat-tile"><span>Visitors</span><b class="num"><%= nice(t.visitors) %></b></div>
  <div class="stat-tile"><span>Page views</span><b class="num"><%= nice(t.views) %></b></div>
  <div class="stat-tile"><span>Demo requests</span><b class="num"><%= nice(ev.demo_requested || 0) %></b></div>
  <div class="stat-tile"><span>Sign-ups</span><b class="num"><%= nice(ev.signup_completed || 0) %></b></div>
  <div class="stat-tile"><span>Visitors who got in touch</span><b class="num"><%= rate.toFixed(rate && rate < 10 ? 1 : 0) %>%</b></div>
</div>

<section class="surface">
  <div class="surface-head"><h2>Visitors per day</h2><span class="small muted">Hover a bar for the day's numbers</span></div>
  <div class="surface-body">
    <% if (!t.visitors) { %><p class="muted" style="margin:0">No visits yet in this period. Share your link and they'll show up here within a minute.</p>
    <% } else { %>
    <div class="bars" aria-hidden="true">
      <div class="bars-axis"><span class="num"><%= nice(max) %></span><span class="num">0</span></div>
      <div class="bars-plot">
        <% for (const d of series) { %><div class="bar-col" title="<%= label(d.day) %>: <%= d.visitors %> visitor<%= d.visitors === 1 ? '' : 's' %>, <%= d.views %> page view<%= d.views === 1 ? '' : 's' %><%= d.leads ? ', ' + d.leads + ' demo request or sign-up' : '' %>"><i style="height:<%= (d.visitors / max * 100).toFixed(1) %>%"></i><% if (d.leads) { %><em></em><% } %></div><% } %>
      </div>
    </div>
    <div class="bars-x small muted"><span><%= label(series[0].day) %></span><span><%= label(series[series.length - 1].day) %></span></div>
    <p class="small muted" style="margin:12px 0 0"><span class="lead-dot"></span> marks a day with a demo request or sign-up.</p>
    <details class="table-view"><summary>Show as a table</summary>
      <table class="ledger"><thead><tr><th>Day</th><th>Visitors</th><th>Page views</th><th>Requests and sign-ups</th></tr></thead>
      <tbody><% for (const d of [...series].reverse()) { %><tr><td><%= label(d.day) %></td><td class="num"><%= d.visitors %></td><td class="num"><%= d.views %></td><td class="num"><%= d.leads %></td></tr><% } %></tbody></table>
    </details>
    <% } %>
  </div>
</section>

<div class="stat-grid">
  <% const block = (title, rows, kLabel, vLabel, name, empty) => { %>
  <section class="surface">
    <div class="surface-head"><h2><%= title %></h2></div>
    <div class="surface-body">
      <% if (!rows.length) { %><p class="muted small" style="margin:0"><%= empty %></p><% } else { const top = Math.max(...rows.map((x) => x.v)); %>
      <table class="rank"><thead><tr><th><%= kLabel %></th><th class="num"><%= vLabel %></th></tr></thead><tbody>
        <% for (const x of rows) { %><tr><td><span class="rank-bar" style="width:<%= (x.v / top * 100).toFixed(1) %>%"></span><span class="rank-k"><%= name ? name(x.k) : x.k %></span></td><td class="num"><%= nice(x.v) %></td></tr><% } %>
      </tbody></table><% } %>
    </div>
  </section>
  <% } %>
  <% block('Pages', r.pages, 'Page', 'Views', (k) => pageNames[k] || k, 'No page views yet.') %>
  <% block('Which button people clicked', r.ctas, 'Button', 'Clicks', (k) => ctaNames[k] || k, 'No clicks on the demo button yet.') %>
  <% block('Where visitors came from', r.referrers, 'Website', 'Visitors', null, 'No visits from other websites yet. Visitors who type the address or click a link in an email or app show as direct and are not listed here.') %>
  <% block('Campaigns', r.sources, 'Source', 'Visitors', null, 'Add ?ref=linkedin (or any name) to links you share, and they\'ll be counted here.') %>
  <% block('Devices', r.devices, 'Device', 'Visitors', (k) => k[0].toUpperCase() + k.slice(1), 'No visits yet.') %>
</div>
<p class="small muted">Bots, link previews and logged-in staff aren't counted. Visitors are counted once per day per device and browser, without cookies, so the same person on two devices counts twice.<% if (ev.spam_blocked) { %> <%= ev.spam_blocked %> spam form submission<%= ev.spam_blocked === 1 ? ' was' : 's were' %> blocked.<% } %></p>
<%- include('partials/foot') %>
