<%- include('partials/head', { title: 'New case' }) %>
<%- include('partials/nav') %>
<a class="back" href="/">← Cases</a>
<form method="post" action="/cases" class="surface form-surface">
  <h1>New case</h1>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Client
    <select name="client_id" required>
      <option value="">Choose a client</option>
      <% for (const c of clients) { %><option value="<%= c.id %>" <%= c.id === selected ? 'selected' : '' %>><%= c.last_name %>, <%= c.first_name %></option><% } %>
    </select>
  </label>
  <label>Case name <input name="title" value="Mortgage application" required maxlength="150"></label>
  <label>Lender <input name="lender" placeholder="Optional" maxlength="120"></label>
  <label>Document checklist
    <select name="template_id">
      <% for (const t of templates) { %><option value="<%= t.id %>"><%= t.name %></option><% } %>
      <option value="">Start with an empty checklist</option>
    </select>
  </label>
  <button class="btn">Create case</button>
</form>
<%- include('partials/foot') %>
